# Copie ce fichier en ".env" puis remplis les valeurs.

# ── Option A : WEBHOOK (le plus simple pour 24/7 sur Railway) ──
# Salon Discord → Paramètres du salon → Intégrations → Webhooks → Nouveau
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# ── Option B : BOT complet (/wallet add, /import…) ──
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_ID=
# DISCORD_ADMIN_IDS=
# PANEL_MESSAGE_ID=   (optionnel — id du message panneau après 1er lancement)

HELIUS_API_KEYS=cle1,cle2,cle3

# Wallets / groupes (modifiable via /wallet sur Discord)
# Local PC : WALLET_STORE_PATH=./data/wallets.json
# Railway sans volume : REDIS_URL (Upstash Connect → TCP) + CLOUD_SYNC_SECRET
# REDIS_URL=rediss://default:PASSWORD@xxx.upstash.io:6379
# CLOUD_SYNC_SECRET=ton_code_8_caracteres_min
# (Optionnel REST : UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN)

# Site : même code secret → Sauvegarde cloud dans Paramètres

# ── Trading Jupiter (bot Discord uniquement) ──
# TRADE_SETTINGS_PATH=/data/trade-settings.json
# TRADE_WALLETS_PATH=/data/trade-wallets.json
# Ou wallets signataires via JSON (sur Railway, jamais dans Git) :
# TRADE_WALLETS_JSON=[{"id":"main","label":"Main","secretKey":"BASE58_PRIVATE_KEY"}]
