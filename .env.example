# Clé Helius (https://helius.dev) — même usage que dans l’app
HELIUS_API_KEY=ta_cle_helius

# Topic ntfy (identique à l’app mobile + Paramètres du tracker)
NTFY_TOPIC=ton_topic_secret_long

# Wallets à surveiller (export depuis Paramètres → « Copier config cloud »)
WATCH_WALLETS=[{"addr":"ADRESSE_WALLET_1","label":"Bundle 1"},{"addr":"ADRESSE_WALLET_2","label":"Bundle 2"}]

# Vercel Cron — génère une chaîne aléatoire (Vercel l’envoie en Authorization)
CRON_SECRET=change_moi_aleatoire

# Optionnel : âge max des txs sans Vercel KV (secondes)
POLL_MAX_AGE_SEC=90
